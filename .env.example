# REQUIRED: random signing key, at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server REFUSES to start with a placeholder or short key.
SECRET_KEY=
LLM_PROVIDER=extractive
# Optional: comma-separated allowed frontend origins for CORS.
# Defaults to http://localhost:5173,http://127.0.0.1:5173 (Vite dev server).
# CORS_ORIGINS=http://localhost:5173
# Optional: set NER_STRICT=1 to fail closed when the fine-tuned DLP model
# checkpoint (models/distilbert-ner) is missing, instead of regex-only fallback.
# NER_STRICT=1
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
HF_MODEL=google/flan-t5-small
